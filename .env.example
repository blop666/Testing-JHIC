DATABASE_URL=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
CHATBOT_PROVIDER_URL=
CHATBOT_PROVIDER_KEY=

# Email tujuan pesan dari form kontak (default: blop.6672@gmail.com)
CONTACT_EMAIL=blop.6672@gmail.com

# Media storage: "local" (default) atau "s3" (MinIO / S3-compatible)
MEDIA_STORAGE=local

# S3/MinIO (hanya dipakai jika MEDIA_STORAGE=s3)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cibione-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# URL publik bucket, termasuk nama bucket (mis. https://media.domain.com/cibione-media).
# Kosongkan untuk pakai S3_ENDPOINT.
S3_PUBLIC_URL=

# Contoh local S3 (LocalStack) untuk development:
# S3_ENDPOINT=http://127.0.0.1:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
